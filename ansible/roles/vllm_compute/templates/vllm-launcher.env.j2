# Managed by Ansible (role: vllm_compute). Secrets of the LLM Launcher on
# {{ inventory_hostname }}, passed to its container with --env-file so no value
# shows in the process list. Root owns this file; the account the launcher
# runs as may read it.
{% if vllm_hf_token | length > 0 %}
HF_TOKEN={{ vllm_hf_token }}
{% endif %}
{% if vllm_launcher_enforce_api_key | bool and vllm_api_key | length > 0 %}
# Every vllm serve the GUI starts inherits this key and requires it.
VLLM_API_KEY={{ vllm_api_key }}
{% endif %}
{% if vllm_launcher_slot | bool %}
# Guards GET /api/stack/slot, which the stack's launcher follower reads.
LAUNCHER_STACK_STATUS_TOKEN={{ vllm_launcher_effective_status_token }}
{% endif %}
