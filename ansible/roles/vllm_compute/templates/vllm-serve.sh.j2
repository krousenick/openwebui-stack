#!/usr/bin/env bash
# Managed by Ansible (role: vllm_compute). vLLM OpenAI server.
#
# Runs on every node in standalone mode, head only in ray mode.
# Rendered values that matter for sharding:
#   --tensor-parallel-size  vllm_effective_tp: GPUs within a node (standalone,
#                            ray+PP) or across the whole cluster (ray+TP).
#   --pipeline-parallel-size vllm_effective_pp: nodes in the ray shard; 1 in
#                            standalone and ray+TP.
# Ray mode points RAY_ADDRESS at the head so `vllm serve` places its workers
# across the cluster instead of spawning them locally.
set -euo pipefail

readonly IMAGE="{{ vllm_image_fq }}"
readonly NAME="{{ vllm_container_name }}-serve"
{% if vllm_hf_token | length > 0 %}
readonly HF_TOKEN="{{ vllm_hf_token }}"
{% endif %}

{{ vllm_container_cli }} pull --quiet "$IMAGE" >/dev/null 2>&1 || true

exec {{ vllm_container_cli }} run \
  --rm \
  --name "$NAME" \
  --network host \
{% if vllm_container_init_flags | length > 0 %}
  {{ vllm_container_init_flags }} \
{% endif %}
{% if vllm_rootless | bool %}
  --security-opt no-new-privileges \
{# podman run relays the container output to the unit, which is what
   `journalctl -u` and the log shipper read. podman's own journald logging
   would file every line a second time under the same unit; passthrough
   would file it under the account's scope instead of the unit. #}
  --log-driver none \
{% endif %}
{% if vllm_container_cli == 'docker' %}
  --shm-size {{ vllm_shm_size }} \
{% endif %}
{% if vllm_mask_fips_flag | bool and vllm_container_cli == 'podman' %}
  -v /dev/null:/proc/sys/crypto/fips_enabled \
{% endif %}
  {{ vllm_container_gpu_flag }} \
  --ipc host \
  --entrypoint /bin/bash \
  -v {{ vllm_hf_cache_dir }}:/root/.cache/huggingface \
{% if vllm_hf_token | length > 0 %}
  -e HF_TOKEN="$HF_TOKEN" \
{% endif %}
{% if vllm_deployment_mode == 'ray' %}
  -e VLLM_HOST_IP={{ vllm_host_ip }} \
  -e RAY_ADDRESS={{ vllm_ray_head_address }}:{{ vllm_ray_head_port }} \
{% endif %}
{% if vllm_api_key | length > 0 %}
  -e VLLM_API_KEY="{{ vllm_api_key }}" \
{% endif %}
  "{{ vllm_image_fq }}" \
  -lc "vllm serve {{ vllm_model }} \
    --served-model-name {{ vllm_served_model_name }} \
    --host 0.0.0.0 \
    --port {{ vllm_port }} \
    --max-model-len {{ vllm_max_model_len }} \
    --gpu-memory-utilization {{ vllm_gpu_memory_utilization }} \
    --tensor-parallel-size {{ vllm_effective_tp }} \
{% if vllm_deployment_mode == 'ray' %}
    --pipeline-parallel-size {{ vllm_effective_pp }} \
    --distributed-executor-backend ray \
{% endif %}
    --enable-prefix-caching \
    --disable-log-requests \
{% if vllm_reasoning_parser | length > 0 %}
    --reasoning-parser {{ vllm_reasoning_parser }} \
{% endif %}
{% if vllm_chat_template_kwargs | default({}) | length > 0 %}
    --default-chat-template-kwargs {{ vllm_chat_template_kwargs | to_json | quote }} \
{% endif %}
    {{ vllm_extra_args | join(' ') }}"
