#!/usr/bin/env bash
# Managed by Ansible (role: vllm_compute). vLLM aux model server for model
# {{ aux_item.name }} (served as {{ aux_item.served_model_name }}).
#
# One instance per vllm_aux_models entry placed on this node, run by its
# vllm-aux-{{ aux_item.name }} systemd unit. Single-model standalone
# `vllm serve` - no Ray, no cross-node sharding; --tensor-parallel-size
# spans this node's GPUs only. Shares the HF cache dir with the primary
# model server and the flux servers.
set -euo pipefail

readonly IMAGE="{{ vllm_aux_image_fq }}"
readonly NAME="{{ vllm_container_name }}-aux-{{ aux_item.name }}"
{% if vllm_hf_token | length > 0 %}
readonly HF_TOKEN="{{ vllm_hf_token }}"
{% endif %}

{{ vllm_container_cli }} pull --quiet "$IMAGE" >/dev/null 2>&1 || true

exec {{ vllm_container_cli }} run \
  --rm \
  --name "$NAME" \
  --network host \
{% if vllm_container_cli == 'docker' %}
  --shm-size {{ vllm_shm_size }} \
{% endif %}
{% if vllm_mask_fips_flag | bool and vllm_container_cli == 'podman' %}
  -v /dev/null:/proc/sys/crypto/fips_enabled \
{% endif %}
  {{ vllm_container_gpu_flag }} \
  --ipc host \
  --entrypoint /bin/bash \
  -v {{ vllm_hf_cache_dir }}:/root/.cache/huggingface \
{% if vllm_hf_token | length > 0 %}
  -e HF_TOKEN="$HF_TOKEN" \
{% endif %}
  -e HF_TOKENIZERS_PARALLELISM=0 \
{% if aux_item.api_key | length > 0 %}
  -e VLLM_API_KEY="{{ aux_item.api_key }}" \
{% endif %}
  -e VLLM_LOGGING_LEVEL=INFO \
  "$IMAGE" \
  -lc "vllm serve {{ aux_item.model }} \
    --served-model-name {{ aux_item.served_model_name }} \
    --host 0.0.0.0 \
    --port {{ aux_item.port }} \
    --max-model-len {{ aux_item.max_model_len }} \
    --gpu-memory-utilization {{ aux_item.gpu_memory_utilization }} \
    --tensor-parallel-size {{ aux_item.tensor_parallel_size }} \
{% if aux_item.reasoning_parser | default('') | length > 0 %}
    --reasoning-parser {{ aux_item.reasoning_parser }} \
{% endif %}
{% if aux_item.chat_template_kwargs | default({}) | length > 0 %}
    --default-chat-template-kwargs {{ aux_item.chat_template_kwargs | to_json | quote }} \
{% endif %}
    {{ aux_item.extra_args | join(' ') }}"
