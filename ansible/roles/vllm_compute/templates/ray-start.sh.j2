#!/usr/bin/env bash
# Managed by Ansible (role: vllm_compute). Ray {{ vllm_ray_role }} node.
# Starts the Ray daemon the vLLM workers attach to. Head starts the GCS
# server on vllm_ray_head_port with the pinned dashboard/manager ports;
# workers connect to the head address. Ports must match the firewalld zone
# opened by firewall.yml.
set -euo pipefail

readonly IMAGE="{{ vllm_image_fq }}"
readonly NAME="{{ vllm_container_name }}-ray"
{% if vllm_hf_token | length > 0 %}
readonly HF_TOKEN="{{ vllm_hf_token }}"
{% endif %}

{{ vllm_container_cli }} pull --quiet "$IMAGE" >/dev/null 2>&1 || true

exec {{ vllm_container_cli }} run \
  --rm \
  --name "$NAME" \
  --network host \
{% if vllm_container_init_flags | length > 0 %}
  {{ vllm_container_init_flags }} \
{% endif %}
{% if vllm_rootless | bool %}
  --security-opt no-new-privileges \
{# podman run relays the container output to the unit, which is what
   `journalctl -u` and the log shipper read. podman's own journald logging
   would file every line a second time under the same unit; passthrough
   would file it under the account's scope instead of the unit. #}
  --log-driver none \
{% endif %}
{% if vllm_container_cli == 'docker' %}
  --shm-size {{ vllm_shm_size }} \
{% endif %}
{% if vllm_mask_fips_flag | bool and vllm_container_cli == 'podman' %}
  -v /dev/null:/proc/sys/crypto/fips_enabled \
{% endif %}
  {{ vllm_container_gpu_flag }} \
  --ipc host \
  --entrypoint /bin/bash \
  -v {{ vllm_hf_cache_dir }}:/root/.cache/huggingface \
{% if vllm_hf_token | length > 0 %}
  -e HF_TOKEN="$HF_TOKEN" \
{% endif %}
  -e VLLM_HOST_IP={{ vllm_host_ip }} \
  "{{ vllm_image_fq }}" \
  -lc "ray start --block {% if vllm_ray_role == 'head' %}--head --node-ip-address={{ vllm_host_ip }} --port={{ vllm_ray_head_port }} --dashboard-host 0.0.0.0 --dashboard-port={{ vllm_ray_dashboard_port }} --node-manager-port={{ vllm_ray_node_manager_port }} --object-manager-port={{ vllm_ray_object_manager_port }} --runtime-env-agent-port={{ vllm_ray_runtime_env_agent_port }} --min-worker-port={{ vllm_ray_min_worker_port }} --max-worker-port={{ vllm_ray_max_worker_port }}{% else %}--address={{ vllm_ray_head_address }}:{{ vllm_ray_head_port }} --node-ip-address={{ vllm_host_ip }} --node-manager-port={{ vllm_ray_node_manager_port }} --object-manager-port={{ vllm_ray_object_manager_port }} --runtime-env-agent-port={{ vllm_ray_runtime_env_agent_port }} --min-worker-port={{ vllm_ray_min_worker_port }} --max-worker-port={{ vllm_ray_max_worker_port }}{% endif %}"
