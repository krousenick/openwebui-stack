  "templating": {
    "list": [
      {
        "name": "node",
        "label": "vLLM Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=~\"remote-node|remote-nvidia-gpu|remote-nvidia-smi|remote-vllm|remote-aux-.*\"}, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "deployment",
        "label": "Inference Deployment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_names(vllm:num_requests_running{job=~\"remote-vllm|remote-aux-.*\"})", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      },
      {
        "name": "log_filter",
        "label": "Log Filter",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "query": "label_values(service_name)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "vLLM Remote Nodes",
  "uid": "vllm-remote-nodes",
  "version": 2,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Node Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "expr": "up{job=\"remote-node\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "vLLM API Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "expr": "up{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GPU Exporter Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "expr": "up{job=~\"remote-nvidia-gpu|remote-nvidia-smi\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GPU Count",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "targets": [ { "expr": "count(count(DCGM_FI_DEV_GPU_UTIL{instance=~\"$node\"}) by (instance, gpu)) or count(count(nvidia_smi_utilization_gpu_ratio{instance=~\"$node\"}) by (instance, uuid))", "legendFormat": "GPUs", "refId": "A" } ],
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Prompt Tokens",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": 0 } ] }, "unit": "short" }, "overrides": [] },
      "targets": [ { "expr": "sum(vllm:prompt_tokens_total{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"})", "legendFormat": "prompt", "refId": "A" } ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "description": "Cumulative prompt tokens from all vLLM deployments"
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total Completion Tokens",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "purple", "value": 0 } ] }, "unit": "short" }, "overrides": [] },
      "targets": [ { "expr": "sum(vllm:completion_tokens_total{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"})", "legendFormat": "completion", "refId": "A" } ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" },
      "description": "Cumulative completion tokens from all vLLM deployments"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GPU Temperature",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "celsius", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 88 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_GPU_TEMP{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "nvidia_smi_temperature_gpu{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU Power Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "watt", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 400 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_POWER_USAGE{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "nvidia_smi_power_draw_watts{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GPU Memory Used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 22000 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_FB_USED{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "nvidia_smi_memory_used_bytes{instance=~\"$node\"} / 1024 / 1024", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU Utilization",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 95 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_GPU_UTIL{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "100 * nvidia_smi_utilization_gpu_ratio{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Token Rate (per deployment)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "targets": [ { "expr": "sum by (instance) (rate(vllm:prompt_tokens_total{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{ "{{ instance }}" }} prompt", "refId": "A" }, { "expr": "sum by (instance) (rate(vllm:completion_tokens_total{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{ "{{ instance }}" }} completion", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } },
      "description": "Token throughput per second by instance (prompt vs completion)"
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "vLLM Requests per Instance",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "targets": [ { "expr": "vllm:num_requests_running{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }} running", "refId": "A" }, { "expr": "vllm:num_requests_waiting{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }} waiting", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } },
      "description": "Running vs waiting requests per deployment"
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "vLLM KV Cache Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "targets": [ { "expr": "vllm:kv_cache_usage_perc{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Request Success Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "targets": [ { "expr": "sum by (instance) (rate(vllm:request_success_total{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{ "{{ instance }}" }} success/s", "refId": "A" }, { "expr": "sum by (instance) (rate(vllm:request_failure_total{job=~\"remote-vllm|remote-aux-.*\", instance=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{ "{{ instance }}" }} failure/s", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } },
      "description": "Request success vs failure rate per second"
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "CPU Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "targets": [ { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", job=\"remote-node\", instance=~\"$node\"}[$__rate_interval])) * 100)", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "targets": [ { "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"remote-node\", instance=~\"$node\"} / node_memory_MemTotal_bytes{job=\"remote-node\", instance=~\"$node\"}))", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 40,
      "type": "logs",
      "title": "vLLM Serve Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 44 },
      "targets": [ { "expr": "{service_name=\"vllm-serve\"} |~ \"$log_filter\"", "refId": "A" } ],
      "options": { "dedupStrategy": "none", "enableInfiniteScrolling": true, "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "description": "vllm-serve journald logs from all compute nodes"
    },
    {
      "id": 41,
      "type": "logs",
      "title": "Aux/Deployment Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 44 },
      "targets": [ { "expr": "{service_name=~\"gatekeeper|flux-.*|aux-.*\"} |~ \"$log_filter\"", "refId": "A" } ],
      "options": { "dedupStrategy": "none", "enableInfiniteScrolling": true, "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "description": "Gatekeeper and other aux deployment logs from all compute nodes"
    }
  ]
