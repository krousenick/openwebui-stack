{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["vllm", "remote-nodes"],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "vLLM Node",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(up{job=~\"remote-node|remote-nvidia-gpu|remote-nvidia-smi|remote-vllm\"}, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "log_filter",
        "label": "Log Filter",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "vLLM Remote Nodes",
  "uid": "vllm-remote-nodes",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Node Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "expr": "up{job=\"remote-node\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU Exporter Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "expr": "up{job=~\"remote-nvidia-gpu|remote-nvidia-smi\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "vLLM API Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "expr": "up{job=\"remote-vllm\", instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GPU Count",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "targets": [ { "expr": "count(count(DCGM_FI_DEV_GPU_UTIL{instance=~\"$node\"}) by (instance, gpu)) or count(count(nvidia_smi_utilization_gpu_ratio{instance=~\"$node\"}) by (instance, uuid))", "legendFormat": "GPUs", "refId": "A" } ],
      "options": { "colorMode": "none", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GPU Temperature",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "celsius", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 88 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_GPU_TEMP{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "nvidia_smi_temperature_gpu{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU Power Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "watt", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 400 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_POWER_USAGE{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "nvidia_smi_power_draw_watts{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GPU Memory Used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "red", "value": 22000 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_FB_USED{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "nvidia_smi_memory_used_bytes{instance=~\"$node\"} / 1024 / 1024", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU Utilization",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 95 } ] } }, "overrides": [] },
      "targets": [ { "expr": "DCGM_FI_DEV_GPU_UTIL{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ gpu }}" }}", "refId": "A" }, { "expr": "100 * nvidia_smi_utilization_gpu_ratio{instance=~\"$node\"}", "legendFormat": "{{ "{{ instance }} GPU {{ uuid }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "CPU Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "targets": [ { "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", job=\"remote-node\", instance=~\"$node\"}[$__rate_interval])) * 100)", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "targets": [ { "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"remote-node\", instance=~\"$node\"} / node_memory_MemTotal_bytes{job=\"remote-node\", instance=~\"$node\"}))", "legendFormat": "{{ "{{ instance }}" }}", "refId": "A" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Disk Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "targets": [ { "expr": "100 - ((node_filesystem_avail_bytes{job=\"remote-node\", instance=~\"$node\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"remote-node\", instance=~\"$node\", fstype!~\"tmpfs|overlay\"}) * 100)", "legendFormat": "{{ "{{ instance }} {{ mountpoint }}" }}", "refId": "A" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Network Throughput",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "targets": [ { "expr": "rate(node_network_receive_bytes_total{job=\"remote-node\", instance=~\"$node\", device!~\"lo|veth.*|docker.*\"}[$__rate_interval])", "legendFormat": "{{ "RX {{ instance }} {{ device }}" }}", "refId": "A" }, { "expr": "rate(node_network_transmit_bytes_total{job=\"remote-node\", instance=~\"$node\", device!~\"lo|veth.*|docker.*\"}[$__rate_interval])", "legendFormat": "{{ "TX {{ instance }} {{ device }}" }}", "refId": "B" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "vLLM KV Cache Usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "targets": [ { "expr": "vllm:kv_cache_usage_perc{job=\"remote-vllm\", instance=~\"$node\"}", "legendFormat": "{{ "KV cache {{ instance }}" }}", "refId": "A" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "vLLM Requests",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": 0 } ] } }, "overrides": [] },
      "targets": [ { "expr": "sum(rate(vllm:request_success_total{job=\"remote-vllm\", instance=~\"$node\"}[$__rate_interval]))", "legendFormat": "successful/s", "refId": "A" }, { "expr": "vllm:num_requests_running{job=\"remote-vllm\", instance=~\"$node\"}", "legendFormat": "{{ "running {{ instance }}" }}", "refId": "B" }, { "expr": "vllm:num_requests_waiting{job=\"remote-vllm\", instance=~\"$node\"}", "legendFormat": "{{ "waiting {{ instance }}" }}", "refId": "C" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": [ "lastNotNull", "max" ] }, "tooltip": { "mode": "multi" } },
      "description": "Requires the remote-vllm scrape job in otel/config.yaml."
    },
    {
      "id": 40,
      "type": "logs",
      "title": "vLLM Serve Logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 44 },
      "targets": [ { "expr": "{service_name=\"vllm-serve\"} |~ \"$log_filter\"", "refId": "A" } ],
      "options": { "dedupStrategy": "none", "enableInfiniteScrolling": true, "enableLogDetails": true, "prettifyLogMessage": false, "showCommonLabels": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "description": "vllm-serve journald logs shipped from the compute nodes by vllm-log-shipper (Grafana Alloy) into Loki. Filter with the log_filter variable; each node carries a node label."
    }
  ]
}
