[Unit]
Description=vLLM Ray node ({{ vllm_ray_role }})
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/bin/bash -c 'until docker info >/dev/null 2>&1; do sleep 2; done'
ExecStart={{ vllm_install_dir }}/ray-start.sh
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=60
KillMode=mixed

# Security
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
