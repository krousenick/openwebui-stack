[Unit]
Description=vLLM Ray node ({{ vllm_ray_role }})
After=network-online.target{% if vllm_container_cli == 'docker' %} docker.service{% endif %}
Wants=network-online.target
{% if vllm_container_cli == 'docker' %}
Requires=docker.service
{% endif %}

[Service]
Type=simple
User=root
Group=root
{% if vllm_container_cli == 'docker' %}
ExecStartPre=/bin/bash -c 'until docker info >/dev/null 2>&1; do sleep 2; done'
{% endif %}
ExecStart={{ vllm_install_dir }}/ray-start.sh
# --rm does not fire when systemd SIGTERMs the {{ vllm_container_cli }} client; remove the
# container explicitly so a restarted unit reuses the name cleanly.
ExecStop=/bin/bash -c '{{ vllm_container_cli }} rm -f {{ vllm_container_name }}-ray || true'
ExecStopPost=/bin/bash -c '{{ vllm_container_cli }} rm -f {{ vllm_container_name }}-ray || true'
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=60
KillMode=control-group

# Security
NoNewPrivileges=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
