#!/usr/bin/env bash
# Managed by Ansible (role: vllm_compute). LLM Launcher GUI for this node.
#
# Runs the launcher image built from {{ vllm_launcher_dir }}/build. The GUI
# listens on 127.0.0.1:{{ vllm_launcher_port }} only (host network); the
# vllm-launcher-auth unit (oauth2-proxy) is the one way in from the network.
# `vllm serve` processes started from the GUI are children of this
# container: they share its GPU access, the Hugging Face cache the Ansible
# units use, and the environment below. Stopping this unit stops them.
set -euo pipefail

readonly IMAGE="{{ vllm_launcher_image }}"
readonly NAME="{{ vllm_container_name }}-launcher"
{% if vllm_hf_token | length > 0 %}
readonly HF_TOKEN="{{ vllm_hf_token }}"
{% endif %}

exec {{ vllm_container_cli }} run \
  --rm \
  --name "$NAME" \
  --network host \
{% if vllm_container_init_flags | length > 0 %}
  {{ vllm_container_init_flags }} \
{% endif %}
{% if vllm_rootless | bool %}
  --security-opt no-new-privileges \
{# podman run relays the container output to the unit, which is what
   `journalctl -u` and the log shipper read. podman's own journald logging
   would file every line a second time under the same unit; passthrough
   would file it under the account's scope instead of the unit. #}
  --log-driver none \
{% endif %}
{% if vllm_container_cli == 'docker' %}
  --shm-size {{ vllm_shm_size }} \
{% endif %}
{% if vllm_mask_fips_flag | bool and vllm_container_cli == 'podman' %}
  -v /dev/null:/proc/sys/crypto/fips_enabled \
{% endif %}
  {{ vllm_container_gpu_flag }} \
  --ipc host \
  -v {{ vllm_hf_cache_dir }}:/root/.cache/huggingface \
  -v {{ vllm_launcher_data_dir }}:/data \
  -e LOCAL_LLM_LAUNCHER_HOME=/data \
{% if vllm_hf_token | length > 0 %}
  -e HF_TOKEN="$HF_TOKEN" \
{% endif %}
  -e HF_TOKENIZERS_PARALLELISM=0 \
{% if vllm_launcher_enforce_api_key | bool and vllm_api_key | length > 0 %}
  -e VLLM_API_KEY="{{ vllm_api_key }}" \
{% endif %}
{% if vllm_deployment_mode == 'ray' %}
  -e VLLM_HOST_IP={{ vllm_host_ip }} \
  -e RAY_ADDRESS={{ vllm_ray_head_address }}:{{ vllm_ray_head_port }} \
{% endif %}
{% for key, value in (vllm_launcher_extra_env | default({})).items() %}
  -e {{ key }}={{ value | string | quote }} \
{% endfor %}
  "$IMAGE" \
  --no-browser \
  --port {{ vllm_launcher_port }} \
  --allow-host {{ vllm_launcher_fqdn }}
