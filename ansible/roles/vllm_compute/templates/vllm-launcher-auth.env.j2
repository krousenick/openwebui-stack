# Managed by Ansible (role: vllm_compute). oauth2-proxy settings for the LLM
# Launcher gate on {{ inventory_hostname }}. Holds the OIDC client secret and
# the cookie secret: mode 0600, root only. Same shape as the voice gate in
# docker-compose.yml on the stack host.
# https://oauth2-proxy.github.io/oauth2-proxy/configuration/providers/keycloak_oidc/
OAUTH2_PROXY_PROVIDER=keycloak-oidc
OAUTH2_PROXY_CLIENT_ID={{ vllm_launcher_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ vllm_launcher_effective_client_secret }}
OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.{{ vllm_launcher_effective_domain }}/realms/{{ vllm_launcher_effective_realm }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ vllm_launcher_fqdn }}/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_SCOPE=openid email profile
{% if vllm_launcher_allowed_roles | default([]) | length > 0 %}
# Only these Keycloak roles get in; everyone else sees a 403 after sign-in.
OAUTH2_PROXY_ALLOWED_ROLES={{ vllm_launcher_allowed_roles | join(',') }}
{% endif %}
OAUTH2_PROXY_COOKIE_SECRET={{ vllm_launcher_cookie_secret }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_NAME=__Secure-launcher-auth
# Behind Traefik on the stack host: trust its X-Forwarded-* headers.
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:{{ vllm_launcher_auth_port }}
OAUTH2_PROXY_SSL_INSECURE_SKIP_VERIFY={{ 'true' if vllm_launcher_effective_skip_verify | bool else 'false' }}
# Upstream mode: the proxy serves /oauth2/* itself and forwards everything
# else to the launcher on this node's loopback.
OAUTH2_PROXY_UPSTREAMS=http://127.0.0.1:{{ vllm_launcher_port }}
# The launcher's test chat and benchmark calls wait on the model.
OAUTH2_PROXY_UPSTREAM_TIMEOUT=10m
OAUTH2_PROXY_FLUSH_INTERVAL=1s
# auth.<domain> is whitelisted so /oauth2/sign_out?rd= can bounce to the
# Keycloak end_session_endpoint for single logout. Comma-separated.
OAUTH2_PROXY_WHITELIST_DOMAINS={{ vllm_launcher_fqdn }},auth.{{ vllm_launcher_effective_domain }}
{% if vllm_launcher_slot | bool %}
# The stack's launcher follower reads what this node serves without a browser
# session: this one GET route passes the gate without a sign-in, and the
# launcher answers it only with the status token (stack_slot.py). Every
# other path still needs a Keycloak sign-in.
OAUTH2_PROXY_SKIP_AUTH_ROUTES=GET=^/api/stack/slot$
{% endif %}
