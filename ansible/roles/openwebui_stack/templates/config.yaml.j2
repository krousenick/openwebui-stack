# =============================================================================
# LiteLLM Proxy Configuration
# =============================================================================
# Documentation: https://docs.litellm.ai/docs/proxy/configs

# General settings
general_settings:
  # Enable detailed logging
  store_model_in_db: true
  store_prompts_in_spend_logs: true

  # OTEL settings for observability
  otel: true

  # Request/Response logging
  json_logs: true

  # Background health checks
  background_health_checks: true # Disables periodic background pings

  # The admin UI's Chat page (litellm_ui_chat_enabled). Off: chat goes
  # through Open WebUI or an API client. A value here overrides the one
  # saved from Admin Settings > UI Settings, so the toggle there has no
  # effect while this line exists. The Playground has no such switch;
  # ui_chat_block_callback.py refuses the model calls of both pages.
  enable_chat_ui: {{ litellm_ui_chat_enabled | default(false) | bool | lower }}

  # Open WebUI sends the logged-in user when ENABLE_FORWARD_USER_INFO_HEADERS=true.
  # The username matches the LiteLLM user_id created by SSO, so Usage attributes spend to that user.
  user_header_mappings:
    - header_name: X-OpenWebUI-User-Name
      litellm_user_role: internal_user

  # OIDC group to team mapping
  # enable_jwt_auth: true
  # litellm_jwtauth:
  #   user_id_jwt_field: "email"
  #   user_email_jwt_field: "email"
  #   user_id_upsert: true
  #   team_ids_jwt_field: "groups"
  #   org_id_jwt_field: "org_id"
  #   enforce_team_based_model_access: true


# Litellm settings
litellm_settings:
  # Enable streaming
  set_verbose: false
{% if litellm_gemini_models_enabled | default(false) | bool %}
  # Semantic skill search over the proxy-hosted skill store (/v1/skills with
  # custom_llm_provider=litellm_proxy). The model_name references the
  # text-embedding deployment in model_list (gemini-embedding-001), which is
  # gated on litellm_gemini_models_enabled like the other Gemini models.
  # https://docs.litellm.ai/docs/skills#semantic-search-over-litellm-hosted-skills
  skill_search_embedding_model: text-embedding
{% endif %}
{% if skills_public_index_enabled | default(true) | bool %}
  # Agent Skills discovery index: publishes every proxy-hosted skill at
  # /.well-known/agent-skills/index.json, each served as a zip at
  # /v1/skills/{skill_id}/archive. Lets any Agent Skills client install the
  # centralized skills with: npx skills add https://litellm.<domain>
  # The index is unauthenticated by design (discovery clients send no
  # credentials), so it exposes skill *content* to anyone who can reach
  # the proxy — same trust level as the Skill Hub. Set
  # skills_public_index_enabled: false in vars.yml to keep skills
  # key-gated only.
  # https://docs.litellm.ai/docs/skills_gateway#agent-skills-discovery-index
  public_skills_index: true
{% endif %}

  # Exact-response cache in Valkey. This is not provider prompt caching.
  # https://docs.litellm.ai/docs/proxy/caching
  cache: true
  cache_params:
    type: redis
    host: os.environ/REDIS_HOST
    port: os.environ/REDIS_PORT
    password: os.environ/REDIS_PASSWORD

  # Provider prompt caching (NOT the Valkey exact-response cache above).
  # enable_anthropic_prompt_caching (LiteLLM >= 1.94.0) auto-injects
  # cache_control checkpoints (system prompt + trailing turn) on anthropic/
  # and bedrock/ Claude models the cost map flags as cache-capable. It never
  # double-injects when the client sets its own cache_control, and it does
  # NOT touch any other provider.
  # Every model family this stack serves, and why nothing further is set:
  #   anthropic/        - the Claude models (litellm_anthropic_models_enabled)
  #                       are the ones this flag injects markers for.
  #   gemini/ (3.x)    - Google implicit caching is automatic and free; do
  #                       NOT add cache_control_injection_points (switches
  #                       to paid explicit context caching with storage).
  #   bedrock/ OSS      - MiniMax/Qwen/Kimi are absent from AWS's prompt
  #                       caching table; markers risk ValidationException.
  #   openai/ + custom  - vLLM/llama.cpp/edge-node deployments: LiteLLM's
  #     api_base         OpenAI marker mapping only fires against
  #                       api.openai.com hosts; off a custom api_base the
  #                       markers are stripped (no-op). Their caching is
  #                       server-side (--enable-prefix-caching /
  #                       --cache-prompt), already on.
  #   ollama/           - LiteLLM ignores cache_control for ollama/;
  #                       Ollama keeps context warm daemon-side.
  # https://docs.litellm.ai/docs/tutorials/prompt_caching
  enable_anthropic_prompt_caching: true

  # OpenTelemetry callbacks for traces and logs. prometheus exposes
  # token counts and latency on /metrics.
  # https://docs.litellm.ai/docs/proxy/prometheus
  callbacks: ["otel", "prometheus"]

  # Request timeout
  request_timeout: 6000

  # Number of retries
  num_retries: 3

  # Drop unsupported parameters for providers. Claude tool calls depend on
  # this: claude-opus-5-5, claude-sonnet-5-5, and claude-fable-5-2 answer a
  # forced tool_choice ("required" or a named function) with a 400. With
  # drop_params on, LiteLLM downgrades it to "auto" for the models its map
  # flags supports_forced_tool_use: false; with it off, LiteLLM returns its
  # own 400 for them. claude-haiku-5-5 still accepts a forced tool_choice.
  drop_params: true

  # Repair tool-call histories instead of failing the request. Claude needs
  # every assistant tool call answered by exactly one tool result in the
  # next turn and rejects a tool result that has no matching call. Open
  # WebUI can send such a history: generation stopped during a tool call, a
  # tool response that failed or was written twice, turns removed by
  # context compaction. With modify_params on, LiteLLM adds a placeholder
  # result for an unanswered call and drops an orphaned or duplicate result
  # before the request reaches Anthropic. This repair runs only in
  # LiteLLM's Anthropic message conversion, so requests to other providers
  # are not rewritten by it. modify_params is a global LiteLLM flag: any
  # other provider adapter that checks it makes its own repairs too.
  # https://docs.litellm.ai/docs/completion/message_sanitization
  modify_params: true

  # Fallback models configuration
  fallbacks: []

  # Built-in content filter does not scan system or tool turns. Those are
  # stack-owned prompts and tool results, not the user message.
  # https://docs.litellm.ai/docs/proxy/guardrails/quick_start
  skip_system_message_in_guardrail: true
  skip_tool_message_in_guardrail: true

# Router settings
router_settings:
  routing_strategy: simple-shuffle # Prevents latency-based routing checks
  enable_pre_call_checks: false # Disables checking model health before every call
  {% if litellm_gemini_models_enabled | default(false) | bool %}
  # Spoken replies. LiteLLM rewrites this to the target before the key allowlist
  # check, so a voice key allows gemini-3.5-flash-lite, not the alias name.
  model_group_alias:
    voice-assistant: gemini-3.5-flash-lite
  {% endif %}

# =============================================================================
# Guardrails
# =============================================================================
# Built-in content filter. No extra service or API key. default_on runs on
# every request, including when the client omits guardrails.
# Secrets and SSN are blocked. Email and phone are masked so the model still
# answers. Prompt-injection and harmful categories block the request.
# https://docs.litellm.ai/docs/proxy/guardrails/litellm_content_filter
guardrails:
  - guardrail_name: default-content-filter
    litellm_params:
      guardrail: litellm_content_filter
      mode: [pre_call, post_call]
      default_on: true
      patterns:
        - pattern_type: prebuilt
          pattern_name: us_ssn
          action: BLOCK
        - pattern_type: prebuilt
          pattern_name: email
          action: MASK
        - pattern_type: prebuilt
          pattern_name: us_phone
          action: MASK
        - pattern_type: prebuilt
          pattern_name: aws_access_key
          action: BLOCK
        - pattern_type: prebuilt
          pattern_name: aws_secret_key
          action: BLOCK
        - pattern_type: prebuilt
          pattern_name: github_token
          action: BLOCK
      categories:
        - category: prompt_injection_jailbreak
          enabled: true
          action: BLOCK
          severity_threshold: high
          # Overrides the built-in conditional match (roleplay/"enable" +
          # "debug mode" etc. false-blocks normal feature-flag requests).
          # Keeps the always-block payload list. See
          # litellm/guardrail_categories/prompt_injection_jailbreak.yaml.
          category_file: "/app/guardrail_categories/prompt_injection_jailbreak.yaml"
        - category: prompt_injection_system_prompt
          enabled: true
          action: BLOCK
          severity_threshold: high
          # Overrides the built-in conditional match ("show"/"list" +
          # "system prompt" false-blocks prompt-engineering discussion).
          # Keeps the always-block payload list. See
          # litellm/guardrail_categories/prompt_injection_system_prompt.yaml.
          category_file: "/app/guardrail_categories/prompt_injection_system_prompt.yaml"
        - category: prompt_injection_sql
          enabled: true
          action: BLOCK
          severity_threshold: medium
          # Overrides the built-in category: the built-in conditional match
          # (SQL identifier + block word, e.g. "alter" + "alter table") blocks
          # every legitimate SQL question. This override keeps only the
          # always-block injection payloads. See
          # litellm/guardrail_categories/prompt_injection_sql.yaml.
          category_file: "/app/guardrail_categories/prompt_injection_sql.yaml"
        - category: prompt_injection_malicious_code
          enabled: true
          action: BLOCK
          severity_threshold: medium
          # Overrides the built-in conditional match ("run"/"process" +
          # "subprocess"/"crontab" false-blocks ordinary Python and its
          # replies). Keeps the always-block payload list. See
          # litellm/guardrail_categories/prompt_injection_malicious_code.yaml.
          category_file: "/app/guardrail_categories/prompt_injection_malicious_code.yaml"
        - category: prompt_injection_data_exfiltration
          enabled: true
          action: BLOCK
          severity_threshold: high
          # Overrides the built-in conditional match ("export"/"collect" +
          # "user data"/"API keys" false-blocks ordinary app work). Keeps
          # the always-block payload list. See
          # litellm/guardrail_categories/prompt_injection_data_exfiltration.yaml.
          category_file: "/app/guardrail_categories/prompt_injection_data_exfiltration.yaml"
        - category: harmful_self_harm
          enabled: true
          action: BLOCK
          severity_threshold: medium
        - category: harmful_violence
          enabled: true
          action: BLOCK
          severity_threshold: medium
        - category: harmful_illegal_weapons
          enabled: true
          action: BLOCK
          severity_threshold: medium
        - category: harmful_child_safety
          enabled: true
          action: BLOCK
          severity_threshold: medium

# =============================================================================
# Model Providers Configuration
# =============================================================================
# Models are configured via environment variables set by setup script
# Environment variables used:
#   - GEMINI_API_KEY: Google Gemini API key
#   - ANTHROPIC_API_KEY: Anthropic API key
#   - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: AWS Bedrock credentials
#   - AWS_REGION: AWS region (default: us-east-1)
# Model IDs checked 2026-10-21 (Claude: 2026-11-09) against:
#   https://docs.litellm.ai/docs/providers/gemini
#   https://docs.litellm.ai/docs/providers/anthropic
#   https://github.com/BerriAI/litellm/blob/main/model_prices_and_context_window.json
#   https://docs.aws.amazon.com/bedrock/latest/userguide/model-cards.html
#
# Adaptive router settings (input_cost_per_token, adaptive_router_preferences)
# are not written here: each model_info below gets them from
# litellm_adaptive_router_preferences (group_vars, merged over the role
# defaults). A model with no entry renders none.
{# Emits the adaptive-router model_info keys for one model_name. The price
   is printed in fixed notation: PyYAML reads "3e-07" as a string. #}
{% macro adaptive_model_info(name) %}
{% set prefs = litellm_adaptive_router_model_info[name] | default({}, true) %}
{% if prefs.input_cost_per_token | default(none) is not none %}
      input_cost_per_token: {{ '%.12f' | format(prefs.input_cost_per_token | float) | regex_replace('0+$', '') | regex_replace('\\.$', '.0') }}
{% endif %}
{% if prefs.quality_tier | default(none) is not none %}
      adaptive_router_preferences:
        quality_tier: {{ prefs.quality_tier | int }}
        strengths: {{ prefs.strengths | default([], true) | to_json }}
{% endif %}
{% endmacro %}

model_list:
{% if litellm_gemini_models_enabled | default(false) | bool %}
  # Google Gemini (Google AI Studio). gemini/ prefix uses GEMINI_API_KEY.
  # Skipped unless litellm_gemini_models_enabled is true (they need
  # GEMINI_API_KEY). The voice-assistant alias routes only to these models,
  # so it is gated by the same flag. The auto and adaptive routers are
  # rendered below from litellm_auto_router_tiers and
  # litellm_adaptive_router_models.
  - model_name: gemini-3.8-flash
    litellm_params:
      model: gemini/gemini-3.8-flash
      api_key: os.environ/GEMINI_API_KEY
      web_search_options:
        search_context_size: medium
    model_info:
      description: "Gemini 3.8 Flash - current fast model"
{{ adaptive_model_info('gemini-3.8-flash') }}
  - model_name: gemini-3.5-flash-lite
    litellm_params:
      model: gemini/gemini-3.5-flash-lite
      api_key: os.environ/GEMINI_API_KEY
      web_search_options:
        search_context_size: low
    model_info:
      description: "Gemini 3.5 Flash-Lite - current lightweight model"
{{ adaptive_model_info('gemini-3.5-flash-lite') }}
  - model_name: gemini-3.1-pro
    litellm_params:
      model: gemini/gemini-3.1-pro-preview
      api_key: os.environ/GEMINI_API_KEY
      web_search_options:
        search_context_size: medium
    model_info:
      description: "Gemini 3.1 Pro preview - current reasoning model"
{{ adaptive_model_info('gemini-3.1-pro') }}
  - model_name: gemini-4-argon
    litellm_params:
      model: gemini/gemini-4-argon
      api_key: os.environ/GEMINI_API_KEY
      web_search_options:
        search_context_size: medium
    model_info:
      description: "Gemini 4 Argon - current Gemini model"
{{ adaptive_model_info('gemini-4-argon') }}
  # Embedding model for LiteLLM's skill search (semantic ranking over the
  # proxy-hosted skills in /v1/skills, see litellm_settings below) and any
  # RAG use. Same GEMINI_API_KEY as the chat models.
  - model_name: text-embedding
    litellm_params:
      model: gemini/gemini-embedding-001
      api_key: os.environ/GEMINI_API_KEY
{% endif %}
{% if litellm_anthropic_models_enabled | default(false) | bool %}

  # Anthropic Claude (Anthropic API). anthropic/ prefix uses
  # ANTHROPIC_API_KEY. Skipped unless litellm_anthropic_models_enabled is
  # true. The model_names equal the Anthropic model IDs, so Anthropic-native
  # clients (Claude Code, the Anthropic SDKs) can point at the proxy's
  # /v1/messages endpoint unchanged, and OpenAI-format clients (Open WebUI)
  # use /v1/chat/completions. Windows and prices come from LiteLLM's cost
  # map (1M input / 128K output), so context compaction and spend tracking
  # need nothing here. enable_anthropic_prompt_caching above injects the
  # cache_control checkpoints.
  # additional_drop_params: these models reject sampling parameters
  # (temperature/top_p/top_k return a 400), and Open WebUI sends them
  # whenever a user or Workspace model sets one. Thinking is adaptive by
  # default and needs no parameter.
  # Tool calls need nothing per model: they use the same three paths as
  # every other model (the Brave injector for non-streaming requests, Open
  # WebUI's MCP tool servers from models.default_metadata for streaming
  # chats, and client-side tools on /v1/messages). The two Claude-specific
  # rules are handled in litellm_settings above: forced tool_choice
  # (drop_params) and tool call/result pairing (modify_params).
  - model_name: claude-opus-5-5
    litellm_params:
      model: anthropic/claude-opus-5-5
      api_key: os.environ/ANTHROPIC_API_KEY
      additional_drop_params: ["temperature", "top_p", "top_k"]
    model_info:
      description: "Claude Opus 5.5 - complex reasoning, coding, and agentic work"
{{ adaptive_model_info('claude-opus-5-5') }}
  - model_name: claude-sonnet-5-5
    litellm_params:
      model: anthropic/claude-sonnet-5-5
      api_key: os.environ/ANTHROPIC_API_KEY
      additional_drop_params: ["temperature", "top_p", "top_k"]
    model_info:
      description: "Claude Sonnet 5.5 - balanced speed and capability"
{{ adaptive_model_info('claude-sonnet-5-5') }}
  - model_name: claude-haiku-5-5
    litellm_params:
      model: anthropic/claude-haiku-5-5
      api_key: os.environ/ANTHROPIC_API_KEY
      additional_drop_params: ["temperature", "top_p", "top_k"]
    model_info:
      description: "Claude Haiku 5.5 - fastest and cheapest Claude model"
{{ adaptive_model_info('claude-haiku-5-5') }}
  # Most capable and most expensive ($8 / $40 per MTok). Not available to
  # Anthropic organizations under zero data retention (400 on every call).
  - model_name: claude-fable-5-2
    litellm_params:
      model: anthropic/claude-fable-5-2
      api_key: os.environ/ANTHROPIC_API_KEY
      additional_drop_params: ["temperature", "top_p", "top_k"]
    model_info:
      description: "Claude Fable 5.2 - most capable Claude model"
{{ adaptive_model_info('claude-fable-5-2') }}
{% endif %}
{% if litellm_auto_router_tiers | length > 0 %}

  # Complexity auto-router. Call model "auto". The heuristic scorer picks a
  # tier with no extra API call. Session affinity is off, so each turn is
  # scored on its own. Tiers come from litellm_auto_router_tiers (group_vars;
  # defaults to the Gemini models when litellm_gemini_models_enabled is
  # true, else the Claude models when litellm_anthropic_models_enabled is
  # true, otherwise unset and this entry is not rendered). A tier value is
  # one model_name or a list (random pick per request); any model_name the
  # proxy serves works, including Bedrock and db-registered vLLM models.
  # Checked against: https://docs.litellm.ai/docs/proxy/auto_routing
  - model_name: auto
    litellm_params:
      model: auto_router/complexity_router
      complexity_router_default_model: {{ litellm_auto_router_default_model | to_json }}
      complexity_router_config:
        tiers:
{% for tier in ['SIMPLE', 'MEDIUM', 'COMPLEX', 'REASONING'] %}
          {{ tier }}: {{ litellm_auto_router_tiers[tier] | to_json }}
{% endfor %}
        classifier_type: heuristic
        session_affinity: false
{% endif %}
{% if litellm_adaptive_router_models | length > 0 %}

  # Adaptive router (beta). Call model "adaptive". A Thompson-sampling bandit
  # learns which model wins per request type (code, writing, analysis...) from
  # satisfaction/stagnation/misalignment signals, weighted quality vs cost.
  # The pool comes from litellm_adaptive_router_models (group_vars; defaults
  # to the Gemini models when litellm_gemini_models_enabled is true, else the
  # Claude models when litellm_anthropic_models_enabled is true, otherwise
  # unset and this entry is not rendered). Cold start uses each pool model's
  # model_info: adaptive_router_preferences (quality_tier + strengths) and
  # input_cost_per_token, rendered above from
  # litellm_adaptive_router_preferences for the models this file declares
  # and by the vllm_compute role (vllm_adaptive_*) for vLLM models; a model
  # without them has no prior and counts as free. ~10 requests per model per
  # type before learned estimates take over. Needs the Postgres DB (state
  # persists in LiteLLM_AdaptiveRouter* tables; already required here).
  # Force frontier on one request: header x-litellm-min-quality-tier: 3.
  # Inspect: GET /adaptive_router/state. Weights must sum to 1.0.
  # https://docs.litellm.ai/docs/adaptive_router
  - model_name: adaptive
    litellm_params:
      model: auto_router/adaptive_router
      adaptive_router_config:
        available_models: {{ litellm_adaptive_router_models | to_json }}
        weights:
          quality: 0.7
          cost: 0.3
{% endif %}

  {% if litellm_bedrock_models_enabled | default(false) | bool %}
  # AWS Bedrock OSS models. IDs are bedrock-runtime model IDs.
  # Kimi K3 has no in-region ID; us-east-1 uses the US geo profile.
  # Skipped unless litellm_bedrock_models_enabled is true (they need
  # AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
  - model_name: minimax-m2.5
    litellm_params:
      model: bedrock/minimax.minimax-m2.5
      aws_access_key_id: os.environ/AWS_ACCESS_KEY_ID
      aws_secret_access_key: os.environ/AWS_SECRET_ACCESS_KEY
      aws_region_name: os.environ/AWS_REGION
    model_info:
      description: "MiniMax M2.5 via AWS Bedrock (us-east-1)"
{{ adaptive_model_info('minimax-m2.5') }}
  - model_name: qwen3-next
    litellm_params:
      model: bedrock/qwen.qwen3-next-80b-a3b
      aws_access_key_id: os.environ/AWS_ACCESS_KEY_ID
      aws_secret_access_key: os.environ/AWS_SECRET_ACCESS_KEY
      aws_region_name: os.environ/AWS_REGION
    model_info:
      description: "Qwen3 Next 80B A3B via AWS Bedrock (us-east-1)"
{{ adaptive_model_info('qwen3-next') }}
  - model_name: qwen3-coder
    litellm_params:
      model: bedrock/qwen.qwen3-coder-next
      aws_access_key_id: os.environ/AWS_ACCESS_KEY_ID
      aws_secret_access_key: os.environ/AWS_SECRET_ACCESS_KEY
      aws_region_name: os.environ/AWS_REGION
    model_info:
      description: "Qwen3 Coder Next via AWS Bedrock (us-east-1)"
{{ adaptive_model_info('qwen3-coder') }}
  - model_name: kimi-k3
    litellm_params:
      model: bedrock/us.moonshotai.kimi-k3
      aws_access_key_id: os.environ/AWS_ACCESS_KEY_ID
      aws_secret_access_key: os.environ/AWS_SECRET_ACCESS_KEY
      aws_region_name: os.environ/AWS_REGION
    model_info:
      description: "Kimi K3 via AWS Bedrock US geo inference"
{{ adaptive_model_info('kimi-k3') }}
  {% endif %}

  # Local llama.cpp Edge Nodes (configured via setup script)
  # Models are dynamically added based on LLAMA_CPP_EDGE_NODES env var
  # Example edge node model config (template):
  # - model_name: llama-3.1-8b-local
  #   litellm_params:
  #     model: openai/llama-3.1-8b-instruct
  #     api_base: http://edge-node-hostname:8080/v1
  #     api_key: local
  #   model_info:
  #     max_input_tokens: 32768
  #     max_tokens: 32768

  # vLLM Flux image generation moved to the vllm_compute Ansible role. The
  # role deploys the containers as systemd services on the compute nodes and
  # renders the model entries into litellm/vllm-models.yaml (one entry per
  # configured model; see vllm_flux_models in the role). Merge that snippet
  # here after running playbooks/inference.yml.

# MCP Servers Configuration
mcp_servers:
{% if brave_search_enabled | default(false) | bool and brave_search_api_key | default('') | length > 0 %}
  brave_search:
    url: "http://brave-search-mcp:8080/mcp"
    transport: "http"
    auth_type: "none"
    allow_all_keys: true
{% endif %}
{% if playwright_mcp_enabled | default(true) | bool %}
  playwright_cluster:
    # Route requests through Traefik's mcp entrypoint (:8082, no redirect),
    # which distributes them across the playwright-mcp replicas.
    # Sticky-cookie routing pins each MCP session to one replica.
    url: "http://traefik:8082/mcp"
    static_headers:
      Host: "playwright-mcp.{{ domain }}" # Must match the Traefik router rule Host
    transport: "http" # Connects via Streamable HTTP/SSE
    auth_type: "none"
    allow_all_keys: true
{% endif %}
{% if printer_mcp_enabled | default(false) | bool and bambu_host | default('') | length > 0 %}
  printer_3d:
    # bambu-printer-mcp (slice_stl / print_3mf / get_printer_status /
    # resolve_3mf_ams_slots / camera_snapshot) for the Bambu H2C.
    url: "http://printer-mcp:3000/mcp"
    transport: "http"
    auth_type: "none"
    allow_all_keys: true
{% endif %}
{% if blender_mcp_enabled | default(false) | bool %}
  blender:
    # mcp-for-blender behind its in-container supergateway (stdI/O ->
    # streamable HTTP). Blender 5.0.1 full GUI under Xvfb; addon 2.2.7 with
    # BLENDER_MCP_SAFE_MODE=1.
    url: "http://blender:8000/mcp"
    transport: "http"
    auth_type: "none"
    allow_all_keys: true
{% endif %}
{% if freecad_mcp_enabled | default(false) | bool %}
  freecad:
    # freecad-mcp (alosslessdev headless bridge) behind its in-container
    # supergateway (stdI/O -> streamable HTTP). FreeCAD 1.1.4 headless via
    # freecadcmd; execute_code / document tools / parts list.
    url: "http://freecad:8000/mcp"
    transport: "http"
    auth_type: "none"
    allow_all_keys: true
{% endif %}
