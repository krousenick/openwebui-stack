# =============================================================================
# Open WebUI Stack - Environment Configuration
# =============================================================================
# Rendered by ansible/roles/openwebui_stack (tasks/environment.yml) from
# group_vars/all/{vars,vault}.yml. Do not edit by hand; re-run the playbook.
# Mode 0600 on the deployed host.

DOMAIN={{ domain }}
COMPOSE_PROJECT_NAME={{ compose_project_name }}

# -----------------------------------------------------------------------------
# SSL
# -----------------------------------------------------------------------------
SSL_CERT_TYPE={{ ssl_cert_type }}
SSL_CERT_FILE=certs/{{ ssl_cert_file }}
SSL_KEY_FILE=certs/{{ ssl_key_file }}

# -----------------------------------------------------------------------------
# PostgreSQL (shared instance; per-service databases below)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD={{ postgres_password }}

# Open WebUI database
OPENWEBUI_DB_NAME=openwebui
OPENWEBUI_DB_USER=openwebui
OPENWEBUI_DB_PASSWORD={{ openwebui_db_password }}

# LiteLLM database
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD={{ litellm_db_password }}

# -----------------------------------------------------------------------------
# Traefik
# -----------------------------------------------------------------------------
TRAEFIK_DASHBOARD_USER={{ traefik_dashboard_user }}
TRAEFIK_DASHBOARD_PASSWORD={{ traefik_dashboard_password }}
# apr1 hash with $ doubled for compose interpolation
TRAEFIK_DASHBOARD_PASSWORD_HASH={{ traefik_dashboard_password_hash }}

# -----------------------------------------------------------------------------
# Open WebUI
# -----------------------------------------------------------------------------
OPENWEBUI_SECRET_KEY={{ openwebui_secret_key }}

# -----------------------------------------------------------------------------
# LiteLLM
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY={{ litellm_master_key }}
LITELLM_SALT_KEY={{ litellm_salt_key }}
GENERIC_CLIENT_STATE={{ litellm_generic_client_state }}

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
# Host docker group id for the monitoring collector (getent group docker)
DOCKER_GID={{ docker_gid }}
{% if grafana_discord_webhook_url | default('') | length > 0 %}

GRAFANA_DISCORD_WEBHOOK_URL={{ grafana_discord_webhook_url }}
{% endif %}

# -----------------------------------------------------------------------------
# Qdrant / Valkey
# -----------------------------------------------------------------------------
QDRANT_API_KEY={{ qdrant_api_key }}
VALKEY_PASSWORD={{ valkey_password }}

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KEYCLOAK_REALM={{ keycloak_realm }}
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD={{ keycloak_db_password }}
KEYCLOAK_ADMIN_USER={{ keycloak_admin_user }}
KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}
KEYCLOAK_ADMIN_IP_RANGE={{ keycloak_admin_ip_range }}

# Provisioner client used by the Ansible playbook itself
KEYCLOAK_PROVISIONER_CLIENT_ID={{ keycloak_provisioner_client_id }}
KEYCLOAK_PROVISIONER_CLIENT_SECRET={{ keycloak_provisioner_client_secret }}

# -----------------------------------------------------------------------------
# OIDC client secrets (registered in Keycloak by this playbook)
# -----------------------------------------------------------------------------
OPENWEBUI_OIDC_CLIENT_ID=open-webui
OPENWEBUI_OIDC_CLIENT_SECRET={{ openwebui_oidc_client_secret }}
LITELLM_OIDC_CLIENT_ID=litellm
LITELLM_OIDC_CLIENT_SECRET={{ litellm_oidc_client_secret }}
GF_OIDC_CLIENT_ID=grafana
GF_OIDC_CLIENT_SECRET={{ grafana_oidc_client_secret }}
{% if chatterbox_enabled | default(false) | bool %}

# -----------------------------------------------------------------------------
# Chatterbox TTS (deployed by the chatterbox role)
# -----------------------------------------------------------------------------
CHATTERBOX_PORT={{ chatterbox_port | default(8004) }}
CHATTERBOX_TTS_MODEL={{ chatterbox_tts_model | default('tts-1') }}
CHATTERBOX_TTS_VOICE={{ chatterbox_tts_voice | default('') }}
{% endif %}

# Voice (oauth2-proxy gate for chatterbox)
VOICE_OIDC_CLIENT_SECRET={{ voice_oidc_client_secret }}
OAUTH2_PROXY_COOKIE_SECRET={{ oauth2_proxy_cookie_secret }}

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS={{ backup_retention_days }}

# -----------------------------------------------------------------------------
# LLM provider keys (optional)
# -----------------------------------------------------------------------------
{% if gemini_api_key | default('') | length > 0 %}
GEMINI_API_KEY={{ gemini_api_key }}
{% endif %}
{% if aws_access_key_id | default('') | length > 0 %}
AWS_ACCESS_KEY_ID={{ aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ aws_secret_access_key }}
AWS_REGION={{ aws_region | default('us-east-1') }}
{% endif %}
{% if brave_search_enabled | bool and brave_search_api_key | length > 0 %}

# -----------------------------------------------------------------------------
# Brave Search MCP
# -----------------------------------------------------------------------------
BRAVE_SEARCH_API_KEY={{ brave_search_api_key }}
{% endif %}
{% if hf_token | default('') | length > 0 %}

# Hugging Face token for gated models (chatterbox / vllm_compute)
HF_TOKEN={{ hf_token }}
{% endif %}
