# Copy to run.local.env (gitignored) and fill in real values.
# Every key can also be exported in the environment instead.

# OrbStack machine that holds the controller SSH key and reaches the
# controller over SSH (the Mac itself does not hold the key).
VLLM_RUN_ORB_MACHINE=fedora

# Controller (stack host): the only machine with SSH access to the compute
# node. ansible runs there.
VLLM_RUN_CONTROLLER_HOST=192.0.2.10
VLLM_RUN_CONTROLLER_USER=controller-user

# SSH key path INSIDE the OrbStack machine above.
VLLM_RUN_SSH_KEY=/home/you/.ssh/id_controller

# Deployed tree on the controller (must sit next to litellm/, otel/,
# grafana/ - the sync puts them there).
VLLM_RUN_REMOTE_TREE=/srv/openwebui-stack
