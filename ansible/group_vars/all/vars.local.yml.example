---
# Copy to vars.local.yml (gitignored) on the machine the playbook runs from
# and set this site's values. The playbooks load it after vars.yml, so
# anything here overrides the tracked default. Secrets do not belong here:
# they go in vault.local.yml.

# Services are published as chatbot.<domain>, auth.<domain>, litellm.<domain>,
# grafana.<domain> and voice.<domain>.
domain: example.com

# A Keycloak theme of your own: put it in keycloak/themes/<name>/ in the
# deployed tree (the directory is mounted into the container) and name it
# here. It becomes the default for every realm that has not chosen one.
# keycloak_default_theme: mytheme

# LLM Launcher portals (docs/vllm-inference.md "LLM Launcher"). The node
# names and addresses go in inventory/hosts.local.yml.
# launcher_enabled: true

# Turn a provider's models on once its key is in vault.local.yml.
# litellm_gemini_models_enabled: true
# litellm_anthropic_models_enabled: true
# litellm_bedrock_models_enabled: true

# Claude Code on your own Claude plan through LiteLLM, for usage tracking
# (README "Claude Code on a Claude subscription"). Needs no key.
# litellm_claude_subscription_enabled: true
