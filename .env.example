# =============================================================================
# Open WebUI Stack - Environment Configuration Example
# =============================================================================

# -----------------------------------------------------------------------------
# General Configuration
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=openwebui-stack
DOMAIN=localhost

# -----------------------------------------------------------------------------
# SSL Certificate Configuration
# -----------------------------------------------------------------------------
# Options: existing, selfsigned, traefik
# - existing: Use certificates from certs/ directory
# - selfsigned: Generate persistent self-signed certificates
# - traefik: Use Traefik default (changes on restart - not recommended)
SSL_CERT_TYPE=selfsigned
# Path to certificate file (relative to project root)
SSL_CERT_FILE=certs/wildcard.crt
# Path to private key file (relative to project root)
SSL_KEY_FILE=certs/wildcard.key

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Shared)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=changeme_postgres_db_password

# Open WebUI Database
OPENWEBUI_DB_NAME=openwebui
OPENWEBUI_DB_USER=openwebui
OPENWEBUI_DB_PASSWORD=changeme_openwebui_db_password

# LiteLLM Database
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=changeme_litellm_db_password

# -----------------------------------------------------------------------------
# Traefik Configuration
# -----------------------------------------------------------------------------
# Dashboard credentials
TRAEFIK_DASHBOARD_USER=admin
# Plain password - will be hashed during setup
TRAEFIK_DASHBOARD_PASSWORD=changeme_traefik_dashboard_password
# Generated apr1 hash - auto-populated by setup script (if used)
TRAEFIK_DASHBOARD_PASSWORD_HASH=changeme_traefik_dashboard_password_hash

# -----------------------------------------------------------------------------
# Open WebUI Configuration
# -----------------------------------------------------------------------------
OPENWEBUI_SECRET_KEY=changeme_openwebui_secret_key

# -----------------------------------------------------------------------------
# LiteLLM Configuration
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=changeme_litellm_master_key
LITELLM_SALT_KEY=changeme_litellm_salt_key

# -----------------------------------------------------------------------------
# Grafana Configuration
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana_password

# Discord webhook for Grafana alerts (optional)
GRAFANA_DISCORD_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Qdrant Configuration
# -----------------------------------------------------------------------------
QDRANT_API_KEY=changeme_qdrant_api_key

# -----------------------------------------------------------------------------
# Valkey Configuration
# -----------------------------------------------------------------------------
VALKEY_PASSWORD=changeme_valkey_password

# -----------------------------------------------------------------------------
# Keycloak Configuration (Identity Provider for SSO)
# -----------------------------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db_password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin_password

# OpenID Connect Clients (registered in Keycloak)
# Open WebUI
OPENWEBUI_OIDC_CLIENT_ID=open-webui
OPENWEBUI_OIDC_CLIENT_SECRET=changeme_openwebui_oidc_client_secret

# LiteLLM
LITELLM_OIDC_CLIENT_ID=litellm
LITELLM_OIDC_CLIENT_SECRET=changeme_litellm_oidc_client_secret

# Grafana
GF_OIDC_CLIENT_ID=grafana
GF_OIDC_CLIENT_SECRET=changeme_grafana_oidc_client_secret

# -----------------------------------------------------------------------------
# Keycloak Security Settings
# -----------------------------------------------------------------------------
# IP range for admin console access (e.g., 10.0.0.0/8, 192.168.1.0/24)
# Use 0.0.0.0/0 to allow all (default)
KEYCLOAK_ADMIN_IP_RANGE=0.0.0.0/0

# -----------------------------------------------------------------------------
# Keycloak Backup Settings
# -----------------------------------------------------------------------------
# Number of days to retain backups (default: 7)
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Keycloak Test Account (for automated testing)
# -----------------------------------------------------------------------------
KEYCLOAK_USER_TEST_ACCOUNT_USERNAME=
KEYCLOAK_USER_TEST_ACCOUNT_PASSWORD=

# -----------------------------------------------------------------------------
# Brave Search MCP Configuration
# -----------------------------------------------------------------------------
BRAVE_SEARCH_API_KEY=changeme_brave_search_api_key

# -----------------------------------------------------------------------------
# LLM Provider API Keys (Optional)
# -----------------------------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=

# AWS Bedrock (for OSS models: MiniMax, Qwen, Kimi)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# llama.cpp Edge Nodes Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of edge node hostnames:ports
# Example: node1.local:8080,node2.local:8080
LLAMA_CPP_EDGE_NODES=



# # -----------------------------------------------------------------------------
# # Keycloak / OIDC
# # -----------------------------------------------------------------------------

# # Keycloak realm used by all application SSO clients.
# KEYCLOAK_REALM=ai-platform

# # Bootstrap administrator for the Keycloak master realm.
# # setup.sh generates these automatically when initializing .env.
# KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc-bootstrap-admin
# KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=changeme_keycloak_bootstrap_password

# # Keycloak database.
# KEYCLOAK_DB_NAME=keycloak
# KEYCLOAK_DB_USER=keycloak
# KEYCLOAK_DB_PASSWORD=changeme_keycloak_db_password

# # Keycloak provisioning client.
# # setup.sh creates this client and writes the generated secret here.
# KEYCLOAK_PROVISIONER_CLIENT_ID=keycloak-provisioner
# KEYCLOAK_PROVISIONER_CLIENT_SECRET=

# # Application OIDC client secrets.
# # setup.sh/configure-keycloak-clients.py populate these.
# GRAFANA_OIDC_CLIENT_SECRET=
# OPENWEBUI_OIDC_CLIENT_SECRET=
# LITELLM_OIDC_CLIENT_SECRET=

