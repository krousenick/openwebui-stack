# =============================================================================
# Open WebUI Stack - Environment Configuration Example
# =============================================================================

# -----------------------------------------------------------------------------
# General Configuration
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=openwebui-stack
DOMAIN=localhost

# -----------------------------------------------------------------------------
# SSL Certificate Configuration
# -----------------------------------------------------------------------------
# Options: existing, selfsigned, traefik
# - existing: Use certificates from certs/ directory
# - selfsigned: Generate persistent self-signed certificates
# - traefik: Use Traefik default (changes on restart - not recommended)
SSL_CERT_TYPE=selfsigned
# Path to certificate file (relative to project root)
SSL_CERT_FILE=certs/wildcard.crt
# Path to private key file (relative to project root)
SSL_KEY_FILE=certs/wildcard.key

# -----------------------------------------------------------------------------
# PostgreSQL Configuration (Shared)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=changeme_postgres_db_password

# Open WebUI Database
OPENWEBUI_DB_NAME=openwebui
OPENWEBUI_DB_USER=openwebui
OPENWEBUI_DB_PASSWORD=changeme_openwebui_db_password

# LiteLLM Database
LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASSWORD=changeme_litellm_db_password

# -----------------------------------------------------------------------------
# Traefik Configuration
# -----------------------------------------------------------------------------
# Dashboard credentials
TRAEFIK_DASHBOARD_USER=admin
# Plain password - will be hashed during setup
TRAEFIK_DASHBOARD_PASSWORD=changeme_traefik_dashboard_password
# Generated apr1 hash - auto-populated by setup script (if used)
TRAEFIK_DASHBOARD_PASSWORD_HASH=changeme_traefik_dashboard_password_hash

# -----------------------------------------------------------------------------
# Open WebUI Configuration
# -----------------------------------------------------------------------------
OPENWEBUI_SECRET_KEY=changeme_openwebui_secret_key

# -----------------------------------------------------------------------------
# LiteLLM Configuration
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=changeme_litellm_master_key
LITELLM_SALT_KEY=changeme_litellm_salt_key
# Voice-assistant virtual key. scripts/create-voice-key.sh writes the real value
# into .env. It can call only the model behind the voice-assistant alias.
LITELLM_VOICE_API_KEY=

# -----------------------------------------------------------------------------
# Grafana Configuration
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana_password
# Host docker group id for the monitoring collector. Default 999.
# getent group docker
DOCKER_GID=999

# Discord webhook for Grafana alerts (optional)
GRAFANA_DISCORD_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Qdrant Configuration
# -----------------------------------------------------------------------------
QDRANT_API_KEY=changeme_qdrant_api_key

# -----------------------------------------------------------------------------
# Valkey Configuration
# -----------------------------------------------------------------------------
VALKEY_PASSWORD=changeme_valkey_password

# -----------------------------------------------------------------------------
# Keycloak Configuration (Identity Provider for SSO)
# -----------------------------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db_password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin_password

# OpenID Connect Clients (registered in Keycloak)
# Open WebUI
OPENWEBUI_OIDC_CLIENT_ID=open-webui
OPENWEBUI_OIDC_CLIENT_SECRET=changeme_openwebui_oidc_client_secret

# LiteLLM
LITELLM_OIDC_CLIENT_ID=litellm
LITELLM_OIDC_CLIENT_SECRET=changeme_litellm_oidc_client_secret
# Required by docker-compose.yml for LiteLLM generic SSO state handling.
# Any non-empty string; keep stable across restarts.
GENERIC_CLIENT_STATE=change-me-before-production

# Grafana
GF_OIDC_CLIENT_ID=grafana
GF_OIDC_CLIENT_SECRET=changeme_grafana_oidc_client_secret

# Voice (Traefik ForwardAuth via oauth2-proxy; Chatterbox has no SSO)
VOICE_OIDC_CLIENT_SECRET=changeme_voice_oidc_client_secret
# 32 URL-safe bytes. openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=changeme_oauth2_proxy_cookie_secret

# -----------------------------------------------------------------------------
# Keycloak Security Settings
# -----------------------------------------------------------------------------
# IP range for admin console access (e.g., 10.0.0.0/8, 192.168.1.0/24)
# Use 0.0.0.0/0 to allow all (default)
KEYCLOAK_ADMIN_IP_RANGE=0.0.0.0/0

# -----------------------------------------------------------------------------
# Keycloak Backup Settings
# -----------------------------------------------------------------------------
# Number of days to retain backups (default: 7)
BACKUP_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Keycloak Test Account (for automated testing)
# -----------------------------------------------------------------------------
KEYCLOAK_USER_TEST_ACCOUNT_USERNAME=
KEYCLOAK_USER_TEST_ACCOUNT_PASSWORD=

# -----------------------------------------------------------------------------
# Brave Search MCP Configuration
# -----------------------------------------------------------------------------
# API key from https://brave.com/search/api/ (free tier: 1 qps, 2000/month).
# Powers web search for all chat models: the brave-search-mcp container serves
# the MCP tools, LiteLLM mounts them at /mcp/brave_search, and a startup hook
# (litellm/brave_mcp_callback.py) injects them into every chat request.
BRAVE_SEARCH_API_KEY=changeme_brave_search_api_key

# -----------------------------------------------------------------------------
# LLM Provider API Keys (Optional)
# -----------------------------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=

# AWS Bedrock (for OSS models: MiniMax, Qwen, Kimi)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# llama.cpp Edge Nodes Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of edge node hostnames:ports
# Example: node1.local:8080,node2.local:8080
LLAMA_CPP_EDGE_NODES=
# CPU nodes of the llama.cpp fleet are CPU-only.

# -----------------------------------------------------------------------------
# vLLM Distributed Inference Compute Nodes
# -----------------------------------------------------------------------------
# Used by the vllm_compute Ansible role (playbooks/inference.yml).
# Bearer token the vLLM API requires. Set before running the playbook;
# leave unset only if the compute nodes are isolated on a private segment.
VLLM_API_KEY=
# Hugging Face token for gated models, read by the same role.
HF_TOKEN=

# -----------------------------------------------------------------------------
# vLLM Flux Image Generation (requires GPU profile)
# -----------------------------------------------------------------------------
# Model to run: black-forest-labs/FLUX.1-dev (quality) or FLUX.1-schnell (fast)
VLLM_FLUX_MODEL=black-forest-labs/FLUX.1-dev
# Host loopback port (used for healthcheck probing from Ansible)
VLLM_FLUX_PORT=8005
# Optional: API key to secure the vLLM endpoint (leave empty for internal-only)
VLLM_FLUX_API_KEY=
# Tensor parallelism (set to number of GPUs for multi-GPU)
VLLM_TENSOR_PARALLEL=1

# Open WebUI can call models without an API key when they're internal-only.
# Uncomment for production deployments:
# VLLM_FLUX_API_KEY=change-me-secure-api-key

# -----------------------------------------------------------------------------
# Chatterbox TTS (https://github.com/devnen/Chatterbox-TTS-Server)
# UI: https://voice.${DOMAIN}   Open WebUI calls http://chatterbox-tts:8004/v1
# Deployed by the Ansible chatterbox role, which checks out the repo to
# ./chatterbox, renders config.yaml, builds, and starts one profile.
# chatterbox_device in Ansible (gpu or cpu) selects it:
#   gpu -> Dockerfile (CUDA, RUNTIME=nvidia). cpu -> Dockerfile.cpu.
# Do not enable both profiles; they share one container name.
#   docker compose --profile chatterbox-gpu up -d
#   docker compose --profile chatterbox-cpu up -d
# HF_TOKEN (above) downloads gated Hugging Face models; public models work without it.
# AUDIO_TTS_* are Open WebUI ConfigVars: after the first boot, change them in
# Admin -> Settings -> Audio, not only in this file.
# -----------------------------------------------------------------------------
# Host loopback port publishing the Chatterbox API (the Ansible role probes it).
# Must match chatterbox_port in the Ansible config.
CHATTERBOX_PORT=8004
# Open WebUI TTS. Voice is a predefined voice name (e.g. Emily.wav); empty uses the server default.
CHATTERBOX_TTS_MODEL=tts-1
CHATTERBOX_TTS_VOICE=




