    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Container log lines matching error patterns (error, exception, fatal, panic), per second, by container. Regex matched per line; no parse stage needed.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (container_name) (count_over_time({container_name=~\"$container\"} |~ \"(?i)error|exception|fatal|panic\" [$__interval]))",
          "legendFormat": "{{container_name}}",
          "refId": "A"
        }
      ],
      "title": "Error lines per second",
      "type": "timeseries"
    },
