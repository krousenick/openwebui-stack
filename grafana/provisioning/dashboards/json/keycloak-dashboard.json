        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(agroal_active_count{job=\"$job\"}) / clamp_min(sum(agroal_active_count{job=\"$job\"}) + sum(agroal_available_count{job=\"$job\"}), 1)",
          "legendFormat": "Pool",
          "refId": "A"
        }
      ],
      "title": "DB pool usage",
      "type": "stat"
    },
