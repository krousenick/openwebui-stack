    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Share of authentication requests faster than 250ms. Keycloak records the 250ms bucket because KC_HTTP_METRICS_SLOS includes 250. Authentication URIs are the templated protocol and login-actions routes.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.95}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/realms/\\\\{realm\\\\}/(protocol|login-actions)/.*\", le=\"0.25\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/realms/\\\\{realm\\\\}/(protocol|login-actions)/.*\"}[5m]))",
          "legendFormat": "SLO",
          "refId": "A"
        }
      ],
      "title": "Auth latency SLO (<250ms)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Share of authentication requests whose Micrometer outcome is SERVER_ERROR.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1,
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 0.001}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/realms/\\\\{realm\\\\}/(protocol|login-actions)/.*\", outcome=\"SERVER_ERROR\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/realms/\\\\{realm\\\\}/(protocol|login-actions)/.*\"}[5m]))",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ],
      "title": "Auth server error rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Successful user login events per second. The event label is lowercase. An empty error label means the event succeeded.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "min": 0,
          "noValue": "0",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(keycloak_user_events_total{job=\"$job\", realm=~\"$realm\", event=\"login\", error=\"\"}[5m])) or vector(0)",
          "legendFormat": "Logins",
          "refId": "A"
        }
      ],
      "title": "Successful logins",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Failed user login events divided by all login events. Failures are the same login event with a non-empty error label, for example invalid_user_credentials.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1,
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.05},
              {"color": "red", "value": 0.2}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "(sum(rate(keycloak_user_events_total{job=\"$job\", realm=~\"$realm\", event=\"login\", error!=\"\"}[5m])) or vector(0)) / clamp_min((sum(rate(keycloak_user_events_total{job=\"$job\", realm=~\"$realm\", event=\"login\"}[5m])) or vector(0)), 0.000001)",
          "legendFormat": "Failure ratio",
          "refId": "A"
        }
      ],
      "title": "Login failure ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Active Agroal connections divided by active plus idle connections.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 0.8}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(agroal_active_count{job=\"$job\"}) / clamp_min(sum(agroal_active_count{job=\"$job\"}) + sum(agroal_available_count{job=\"$job\"}), 1)",
          "legendFormat": "Pool",
          "refId": "A"
        }
      ],
      "title": "DB pool usage",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "In-flight HTTP requests on the Keycloak application listener.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
