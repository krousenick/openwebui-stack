          },
          "min": 0,
          "unit": "ops"
        },
        "overrides": [
          {"matcher": {"id": "byRegexp", "options": ".*invalid.*"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
          {"matcher": {"id": "byRegexp", "options": ".*error.*"}, "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]}
        ]
