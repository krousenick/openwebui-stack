    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Password hash checks per second by outcome. valid means the password matched, invalid means it did not, and error means hashing itself failed.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
