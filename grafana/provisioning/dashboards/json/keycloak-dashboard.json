      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (realm, outcome) (rate(keycloak_credentials_password_hashing_validations_total{job=\"$job\", realm=~\"$realm\"}[5m]))",
          "legendFormat": "{{realm}} {{outcome}}",
          "refId": "A"
