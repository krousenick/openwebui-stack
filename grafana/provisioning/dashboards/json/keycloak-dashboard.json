        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/realms/\\\\{realm\\\\}/(protocol|login-actions)/.*\"}[5m])))",
          "legendFormat": "P50",
