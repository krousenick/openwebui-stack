        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "idle" }, "1": { "color": "yellow", "index": 1, "text": "processing" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }
