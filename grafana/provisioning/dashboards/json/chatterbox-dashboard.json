      "id": 20,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "max by (gpu, modelName) (DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "GPU {{gpu}} {{modelName}}", "refId": "A" }],
      "title": "GPU compute",
      "type": "timeseries"
