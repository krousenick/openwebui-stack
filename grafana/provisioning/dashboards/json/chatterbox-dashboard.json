      "options": { "legend": { "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "max by (voice, language) (chatterbox_voice_file_size_bytes)", "legendFormat": "{{voice}} ({{language}})", "refId": "A" }],
      "title": "Voice library",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
