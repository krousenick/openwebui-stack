        { "expr": "max(chatterbox_parameter_temperature)", "legendFormat": "request temperature", "refId": "C" },
        { "expr": "max(chatterbox_config_exaggeration)", "legendFormat": "default exaggeration", "refId": "D" },
        { "expr": "max(chatterbox_config_cfg_weight)", "legendFormat": "default cfg", "refId": "E" },
        { "expr": "max(chatterbox_config_temperature)", "legendFormat": "default temperature", "refId": "F" }
