      "targets": [{ "expr": "max by (container_name) (container_cpu_utilization{container_name=~\".*chatterbox.*\"})", "legendFormat": "{{container_name}}", "refId": "A" }],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "id": 18,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "max by (container_name) (container_memory_usage_total{container_name=~\".*chatterbox.*\"})", "legendFormat": "{{container_name}} used", "refId": "A" },
        { "expr": "max by (container_name) (container_memory_usage_limit{container_name=~\".*chatterbox.*\"})", "legendFormat": "{{container_name}} limit", "refId": "B" }
      ],
      "title": "Container memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
