        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_proxy_requests_metric_total[15m]))",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "sum(rate(litellm_proxy_failed_requests_metric_total[15m]))",
          "legendFormat": "failed",
          "refId": "B"
        }
      ],
