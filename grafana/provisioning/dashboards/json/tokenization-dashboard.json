      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(rate(litellm_llm_api_latency_metric_sum[15m])) / sum(rate(litellm_output_tokens_metric_total[15m]))", "refId": "A" }],
