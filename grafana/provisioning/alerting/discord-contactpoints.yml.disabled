apiVersion: 1

contactPoints:
  - orgId: 1
    name: Discord
    uid: discord-webhook
    receivers:
      - name: Discord Webhook
        uid: discord-receiver
        type: discord
        settings:
          url: ${GRAFANA_DISCORD_WEBHOOK_URL}
          use_discord_title: true
          message: |
            {{ .CommonLabels.alertname }}
            {{ range .Alerts }}
            **Status:** {{ .Status }}
            **Summary:** {{ .Annotations.summary }}
            **Description:** {{ .Annotations.description }}
            {{ end }}
