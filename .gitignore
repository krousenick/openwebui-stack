# =============================================================================
# Git Ignore for Open WebUI Stack
# =============================================================================

# Environment files with secrets
.env
*.env.local
*.env.*.local
ansible/group_vars/all/vault.local.yml

# Model eval results (vllm_eval role; per-run JSON, kept local)
ansible/tests/eval-results/

# vllm-remote runner local config (real addresses/users/key paths)
ansible/tests/vllm-remote/run.local.env

# Site-specific inventory/group_vars overrides (real addresses, users,
# paths, CIDRs). The committed files ship placeholders; these carry the
# real values and override them when passed as a second -i / by merge order.
ansible/inventory/*.local.yml
ansible/tests/*/inventory.local.yml
ansible/tests/*/group_vars/*/*.local.yml

# SSL Certificates (generated locally)
certs/
*.crt
*.key
*.pem
traefik/dynamic/certs.yml

# Data directories (Docker volumes)
*_data/
data/

# Backup files
backups/
*.tar.gz
*.sql

# Log files
logs/
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Session tokens captured during debugging (bearer credentials)
token.txt

# Docker
.docker/

# Python (if any scripts)
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/

# Node (if any scripts)
node_modules/
npm-debug.log*

# Keep directories but not contents
!grafana/provisioning/dashboards/json/.gitkeep
.magie-coder/
.playwright-mcp/
*.png
.magie-tmp
# Cloudflare Origin CA root (public root CA, safe to commit; used by the opencode role)
!ansible/roles/opencode/files/origin_ca_rsa_root.pem
.tmp*